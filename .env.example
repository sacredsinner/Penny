# ===================================================
# Penny Expense Tracker — Environment Configuration
# ===================================================

# Google Cloud OAuth 2.0 Credentials (see GOOGLE_CLOUD_SETUP.md)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:8888/api/gmail/callback"

# JWT & Token Encryption Secrets (use random 32+ character strings)
JWT_SECRET="penny-super-secret-jwt-token-key-change-this"
ENCRYPTION_KEY="penny-aes-256-gcm-key-change-this-32b"

# Optional Custom Database Path (defaults to .data/penny_db.json locally or /tmp on Netlify)
# STORAGE_FILE_PATH="./.data/penny_db.json"
